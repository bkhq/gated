{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatedConfigStore",
  "type": "object",
  "properties": {
    "database_url": {
      "type": "string",
      "default": "sqlite:data/db"
    },
    "encryption": {
      "$ref": "#/$defs/EncryptionConfig",
      "default": {
        "enable": false
      }
    },
    "external_host": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "http": {
      "$ref": "#/$defs/HttpConfig",
      "default": {
        "certificate": "",
        "cookie_domain": null,
        "cookie_max_age": "1day",
        "external_port": null,
        "key": "",
        "listen": "[::]:8888",
        "session_max_age": "30m",
        "sni_certificates": [],
        "tls": true,
        "trust_x_forwarded_headers": false
      }
    },
    "log": {
      "$ref": "#/$defs/LogConfig",
      "default": {
        "format": "text",
        "console": {
          "level": null
        },
        "file": {
          "format": null,
          "directory": null,
          "enable": false,
          "level": null,
          "prefix": "gated",
          "rotation": "daily"
        },
        "level": null,
        "management_retention": "7days",
        "otlp": null,
        "retention": "7days",
        "send_to": null
      }
    },
    "metrics": {
      "$ref": "#/$defs/MetricsConfig",
      "default": {
        "enable": false,
        "listen": "127.0.0.1:9090"
      }
    },
    "mysql": {
      "$ref": "#/$defs/MySqlConfig",
      "default": {
        "certificate": "",
        "enable": false,
        "external_port": null,
        "key": "",
        "listen": "[::]:33306"
      }
    },
    "postgres": {
      "$ref": "#/$defs/PostgresConfig",
      "default": {
        "certificate": "",
        "enable": false,
        "external_port": null,
        "key": "",
        "listen": "[::]:55432"
      }
    },
    "proxy": {
      "$ref": "#/$defs/ProxyConfig",
      "default": {
        "base_domain": "",
        "behind_proxy": false,
        "certificate": "",
        "enable": false,
        "external_port": null,
        "key": "",
        "listen": "[::]:8443",
        "session_max_age": "30m",
        "tls": true
      }
    },
    "recordings": {
      "$ref": "#/$defs/RecordingsConfig",
      "default": {
        "enable": false,
        "path": "./data/recordings"
      }
    },
    "ssh": {
      "$ref": "#/$defs/SshConfig",
      "default": {
        "enable": false,
        "external_port": null,
        "host_key_verification": "auto_reject",
        "inactivity_timeout": "5m",
        "keepalive_interval": null,
        "keys": "./data/keys",
        "listen": "[::]:2222"
      }
    },
    "sso_providers": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/SsoProviderConfig"
      }
    }
  },
  "$defs": {
    "Duration": {
      "type": "object",
      "properties": {
        "nanos": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "secs",
        "nanos"
      ]
    },
    "EncryptionConfig": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "HttpConfig": {
      "type": "object",
      "properties": {
        "certificate": {
          "type": "string",
          "default": ""
        },
        "cookie_domain": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "cookie_max_age": {
          "type": "string",
          "default": "1day"
        },
        "external_port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "key": {
          "type": "string",
          "default": ""
        },
        "listen": {
          "$ref": "#/$defs/ListenEndpoint",
          "default": "[::]:8888"
        },
        "session_max_age": {
          "type": "string",
          "default": "30m"
        },
        "sni_certificates": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SniCertificateConfig"
          }
        },
        "tls": {
          "type": "boolean",
          "default": true
        },
        "trust_x_forwarded_headers": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ListenEndpoint": {
      "type": "string"
    },
    "LogConfig": {
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/LogFormat",
          "default": "text"
        },
        "console": {
          "description": "Console sink overrides.",
          "$ref": "#/$defs/LogConsoleConfig",
          "default": {
            "level": null
          }
        },
        "file": {
          "description": "Optional rolling-file sink.",
          "$ref": "#/$defs/LogFileConfig",
          "default": {
            "format": null,
            "directory": null,
            "enable": false,
            "level": null,
            "prefix": "gated",
            "rotation": "daily"
          }
        },
        "level": {
          "description": "Default tracing filter directive (e.g. `info`, `gated=debug,russh=info`).\n Falls back to the `RUST_LOG` env var / `-d` CLI flag when unset.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "management_retention": {
          "type": "string",
          "default": "7days"
        },
        "otlp": {
          "description": "Optional OpenTelemetry OTLP exporter. When absent, no traces/logs are\n exported over OTLP.",
          "anyOf": [
            {
              "$ref": "#/$defs/LogOtlpConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retention": {
          "type": "string",
          "default": "7days"
        },
        "send_to": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "LogConsoleConfig": {
      "type": "object",
      "properties": {
        "level": {
          "description": "Per-sink filter override. Falls back to `log.level` when unset.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "LogFileConfig": {
      "type": "object",
      "properties": {
        "format": {
          "description": "Output format for this sink. Falls back to `log.format` when unset.",
          "anyOf": [
            {
              "$ref": "#/$defs/LogFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "directory": {
          "description": "Directory for log files. Relative paths resolve against the config dir.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "enable": {
          "description": "Enable file logging.",
          "type": "boolean",
          "default": false
        },
        "level": {
          "description": "Per-sink filter override. Falls back to `log.level` when unset.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "prefix": {
          "description": "Base file name (rotation suffixes are appended by `tracing-appender`).",
          "type": "string",
          "default": "gated"
        },
        "rotation": {
          "description": "Rotation cadence.",
          "$ref": "#/$defs/LogFileRotation",
          "default": "daily"
        }
      }
    },
    "LogFileRotation": {
      "type": "string",
      "enum": [
        "daily",
        "hourly",
        "minutely",
        "never"
      ]
    },
    "LogFormat": {
      "type": "string",
      "enum": [
        "text",
        "json"
      ]
    },
    "LogOtlpConfig": {
      "type": "object",
      "properties": {
        "endpoint": {
          "description": "OTLP endpoint (e.g. `http://otel-collector:4317` for gRPC,\n `http://otel-collector:4318/v1/traces` for HTTP).",
          "type": "string"
        },
        "headers": {
          "description": "Optional headers (e.g. auth tokens) added to every export request.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "level": {
          "description": "Per-sink filter override. Falls back to `log.level` when unset.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "protocol": {
          "description": "Wire protocol.",
          "$ref": "#/$defs/OtlpProtocol",
          "default": "grpc"
        },
        "service_name": {
          "description": "Service name reported to the collector.",
          "type": "string",
          "default": "gated"
        }
      },
      "required": [
        "endpoint"
      ]
    },
    "MetricsConfig": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": false
        },
        "listen": {
          "$ref": "#/$defs/ListenEndpoint",
          "default": "127.0.0.1:9090"
        }
      }
    },
    "MySqlConfig": {
      "type": "object",
      "properties": {
        "certificate": {
          "type": "string",
          "default": ""
        },
        "enable": {
          "type": "boolean",
          "default": false
        },
        "external_port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "key": {
          "type": "string",
          "default": ""
        },
        "listen": {
          "$ref": "#/$defs/ListenEndpoint",
          "default": "[::]:33306"
        }
      }
    },
    "OtlpProtocol": {
      "type": "string",
      "enum": [
        "grpc",
        "httpprotobuf"
      ]
    },
    "PostgresConfig": {
      "type": "object",
      "properties": {
        "certificate": {
          "type": "string",
          "default": ""
        },
        "enable": {
          "type": "boolean",
          "default": false
        },
        "external_port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "key": {
          "type": "string",
          "default": ""
        },
        "listen": {
          "$ref": "#/$defs/ListenEndpoint",
          "default": "[::]:55432"
        }
      }
    },
    "ProxyConfig": {
      "type": "object",
      "properties": {
        "base_domain": {
          "description": "Wildcard base domain for Host-based target resolution.\n A request whose `Host` header shapes as `<target.name>.<base_domain>`\n resolves to the target named `<target.name>`.  Leave empty to force\n every request to provide an `X-Gated-Target` header.",
          "type": "string",
          "default": ""
        },
        "behind_proxy": {
          "description": "Acknowledges that a trusted TLS-terminating reverse proxy sits in front\n of this listener. Required to bind a non-loopback address while\n `tls = false`; without it, a plaintext listener refuses any\n non-loopback bind so `?gated-token=` and upstream traffic cannot leave\n the host in cleartext. Has no effect when `tls = true`.",
          "type": "boolean",
          "default": false
        },
        "certificate": {
          "type": "string",
          "default": ""
        },
        "enable": {
          "type": "boolean",
          "default": false
        },
        "external_port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "key": {
          "type": "string",
          "default": ""
        },
        "listen": {
          "$ref": "#/$defs/ListenEndpoint",
          "default": "[::]:8443"
        },
        "session_max_age": {
          "type": "string",
          "default": "30m"
        },
        "tls": {
          "description": "When false, serve the proxy listener as plaintext HTTP so a\n TLS-terminating reverse proxy in front (Traefik / nsl) handles TLS.\n When true (default), terminate TLS here using `certificate`/`key`.\n Mirrors `http.tls`.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "RecordingsConfig": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": false
        },
        "path": {
          "type": "string",
          "default": "./data/recordings"
        }
      }
    },
    "SniCertificateConfig": {
      "type": "object",
      "properties": {
        "certificate": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "required": [
        "certificate",
        "key"
      ]
    },
    "SshConfig": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean",
          "default": false
        },
        "external_port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "default": null,
          "maximum": 65535,
          "minimum": 0
        },
        "host_key_verification": {
          "$ref": "#/$defs/SshHostKeyVerificationMode",
          "default": "auto_reject"
        },
        "inactivity_timeout": {
          "type": "string",
          "default": "5m"
        },
        "keepalive_interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "keys": {
          "type": "string",
          "default": "./data/keys"
        },
        "listen": {
          "$ref": "#/$defs/ListenEndpoint",
          "default": "[::]:2222"
        }
      }
    },
    "SshHostKeyVerificationMode": {
      "type": "string",
      "enum": [
        "prompt",
        "auto_accept",
        "auto_reject"
      ]
    },
    "SsoInternalProviderConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "google"
            },
            "client_id": {
              "type": "string"
            },
            "client_secret": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "client_id",
            "client_secret"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "apple"
            },
            "client_id": {
              "type": "string"
            },
            "client_secret": {
              "type": "string"
            },
            "key_id": {
              "type": "string"
            },
            "team_id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "client_id",
            "client_secret",
            "key_id",
            "team_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "azure"
            },
            "client_id": {
              "type": "string"
            },
            "client_secret": {
              "type": "string"
            },
            "tenant": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "client_id",
            "client_secret",
            "tenant"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "custom"
            },
            "additional_trusted_audiences": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "client_id": {
              "type": "string"
            },
            "client_secret": {
              "type": "string"
            },
            "issuer_url": {
              "type": "string"
            },
            "role_mappings": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "string"
              }
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "trust_unknown_audiences": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "type",
            "client_id",
            "client_secret",
            "issuer_url",
            "scopes"
          ]
        }
      ]
    },
    "SsoProviderConfig": {
      "type": "object",
      "properties": {
        "auto_create_users": {
          "type": "boolean",
          "default": false
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/SsoInternalProviderConfig"
        },
        "return_domain_whitelist": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "provider"
      ]
    }
  }
}
