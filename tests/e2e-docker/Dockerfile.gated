# syntax=docker/dockerfile:1.3-labs
# Local-only Dockerfile for e2e tests. Skips `just openapi` because the
# justfile recipe references package.json scripts that don't exist
# (pre-existing drift from 103d7889). admin.types.ts is already committed.
FROM rust:1.93.1-bookworm AS build
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN curl -fsSL https://bun.sh/install | bash \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && cargo install just
ENV PATH="/root/.bun/bin:${PATH}"
COPY . /opt/gated
ENV SOURCE_DATE_EPOCH=0
WORKDIR /opt/gated
RUN just bun install --frozen-lockfile \
    && just bun run build \
    && cargo build --target x86_64-unknown-linux-gnu --features mysql,postgres --release

FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -y update -qq \
    && apt-get install --no-install-recommends -y ca-certificates wget \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
RUN adduser gated --disabled-password --gecos "" --uid 1000 --home /data --shell /usr/sbin/nologin
COPY --from=build /opt/gated/target/x86_64-unknown-linux-gnu/release/gated /usr/local/bin/gated
VOLUME /data
ENV GATED_CONFIG=/data/gated.yaml
ENV DOCKER=1
HEALTHCHECK CMD gated healthcheck
USER gated
ENTRYPOINT ["gated"]
CMD ["run"]
